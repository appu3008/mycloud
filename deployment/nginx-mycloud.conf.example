# MyCloud production reverse proxy (example — review before installing).
# Terminates TLS, serves the Yew static build, proxies API to loopback only.
# Install as /etc/nginx/sites-available/mycloud (requires root; ask first).

server {
    listen 443 ssl http2;
    server_name cloud.your-tailnet-name.ts.net;  # or your LAN/MagicDNS name

    ssl_certificate     /etc/letsencrypt/live/your-name/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your-name/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # The Yew app needs its own WASM + inline styles from the same origin.
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; worker-src 'self' blob:" always;

    client_max_body_size 0;            # chunked uploads; per-chunk limits are in the API
    proxy_request_buffering off;       # stream large chunk PUTs
    proxy_buffering off;               # streaming downloads / range responses

    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
    }

    location /health {
        proxy_pass http://127.0.0.1:8000;
    }

    location / {
        root /home/appu/mycloud/frontend-rs/dist;
        try_files $uri $uri/ /index.html;   # Yew client-side routes
    }
}

server {
    listen 80;
    server_name cloud.your-tailnet-name.ts.net;
    return 301 https://$host$request_uri;
}
