# ============================================================
# MyCloud environment configuration (template)
# Copy to .env and generate values. NEVER commit the real .env.
#   cp .env.example .env
#   python scripts/generate_secret.py
# ============================================================

# --- General ---
# "development" binds nothing publicly; see docs/DEPLOYMENT.md
MYCLOUD_ENVIRONMENT=development
MYCLOUD_LOG_LEVEL=INFO

# --- Server binding (development must stay on loopback) ---
MYCLOUD_HOST=127.0.0.1
MYCLOUD_PORT=8000

# --- Paths (relative to project root or absolute) ---
MYCLOUD_STORAGE_ROOT=storage
MYCLOUD_DATABASE_URL=sqlite:///database/mycloud.db

# --- Security (REQUIRED before first run) ---
# Generate with: python scripts/generate_secret.py
MYCLOUD_SECRET_KEY=
# Database URL for rate limiting is the same as MYCLOUD_DATABASE_URL.

# --- Sessions ---
MYCLOUD_SESSION_TTL_HOURS=168
MYCLOUD_SESSION_ABSOLUTE_TTL_HOURS=2160

# --- Uploads ---
# Chunked/resumable upload tuning
MYCLOUD_UPLOAD_CHUNK_SIZE_MB=8
# Hard single-file cap (MB); 0 = admin setting only
MYCLOUD_MAX_FILE_SIZE_MB=2048

# --- Storage guardrails (section 15) ---
# Never auto-consume disk beyond this percent
MYCLOUD_DISK_USAGE_LIMIT_PCT=85
# Minimum free space MB that must remain on the system disk
MYCLOUD_MIN_FREE_SPACE_MB=30720

# --- Quotas ---
# Default per-user quota MB (admin per-user override lives in DB)
MYCLOUD_DEFAULT_QUOTA_MB=20480

# --- CORS (frontend dev origin) ---
MYCLOUD_CORS_ORIGINS=http://127.0.0.1:5173

# --- Cookies ---
# Set to "true" in production with HTTPS (Tailscale/proxy)
MYCLOUD_COOKIE_SECURE=false
